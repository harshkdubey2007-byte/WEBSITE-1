/up-work-icon.svg\",\"uploads/covered-projects/meta-icon.svg\",\"uploads/covered-projects/hotstar-icon.svg\",\"uploads/covered-projects/google-analysis-icon.svg\"],\"is_new\":false,\"CategoryMasters\":[{\"id\":4}],\"Centers\":[{\"id\":3,\"name\":\"Online\",\"crm_center_id\":1}]},{\"id\":173,\"course_name\":\"Professional Certification in AI\",\"course_mode\":\"Online\",\"course_img_url\":\"uploads/courses-images/advanced-ai-marketing-bootcamp.webp\",\"course_duration\":8,\"duration_unit\":\"Weeks\",\"course_tagline\":null,\"course_tags\":null,\"course_review\":4.9,\"course_review_count\":18789,\"slug\":\"ai-course\",\"crm_lead_course_id\":342,\"img_json_url\":\"uploads/images/courses/json-images/ai-dm-course.json\",\"order\":16,\"course_brochure\":\"uploads/pdfs/brochures_new/Professional+Certification/Professional_Certification_in_AI_Jun2026.pdf\",\"course_live_session\":64,\"course_projects\":8,\"course_mode_display\":\"Online\",\"crm_center_id\":4,\"covered_projects\":[\"uploads/covered-projects/brand_nexus.svg\",\"uploads/covered-projects/insight_engine.svg\",\"uploads/covered-projects/performance_x.svg\",\"uploads/covered-projects/agent_ops.svg\"],\"is_new\":true,\"CategoryMasters\":[{\"id\":4}],\"Centers\":[{\"id\":3,\"name\":\"Online\",\"crm_center_id\":1}]}],\"testimonials\":[{\"rating\":5,\"review\":\"I was searching for a comprehensive Google Ads course, and I'm so glad I found WsCube Tech. The mentorship and guidance provided by the instructors were top-notch. They not only taught us the theory but also shared practical tips and strategies. I now feel equipped to manage and optimize Google Ads campaigns effectively. Highly recommended!\",\"reviewee_name\":\"Sneha Verma\",\"reviewee_pic\":null},{\"rating\":5,\"review\":\"As someone with no prior experience in online advertising, I was initially hesitant about enrolling in the online Google AdWords course. However, it turned out to be the best decision I made. The course was well-structured, and the mentors were patient and supportive. Thank you, WsCube Tech, for a fantastic learning experience!\",\"reviewee_name\":\"Rajat Kumar\",\"reviewee_pic\":null},{\"rating\":5,\"review\":\"I can't express how much I've gained from the Google Ads training at WsCube Tech. The live classes were incredibly informative, and the hands-on projects helped me apply what I learned in real-world scenarios. Having a mentor to guide me through the course was invaluable. I'm now Google Ads certified and confident in running successful campaigns. Thank you, WsCube Tech!\",\"reviewee_name\":\"Aarav Sharma\",\"reviewee_pic\":null},{\"rating\":5,\"review\":\"The online Google Adwords training at WsCube Tech exceeded my expectations. The live classes made learning interactive and engaging, and the real-world projects challenged me to apply my knowledge. What sets this course apart is the mentorship – having a knowledgeable mentor to answer my questions and provide feedback was a game-changer. I'm thrilled to have earned my Google Ads certification through this program.\",\"reviewee_name\":\"Arjun Mehta\",\"reviewee_pic\":null},{\"rating\":null,\"review\":\"$14\",\"reviewee_name\":\"Iqbal Khan\",\"reviewee_pic\":\"uploads/master-class-media/704.jpg\"}]},\"topRecuritersData\":[{\"name\":\"Amazon\",\"img_url\":\"uploads/images/top-companies/white/amazon.svg\",\"img_color_url\":\"uploads/images/top-companies/color/amazon.svg\"},{\"name\":\"Accenture\",\"img_url\":\"uploads/images/top-companies/white/accenture.svg\",\"img_color_url\":\"uploads/images/top-companies/color/accenture.svg\"},{\"name\":\"Bewakoof\",\"img_url\":\"uploads/images/top-companies/white/bewakoof.svg\",\"img_color_url\":\"uploads/images/top-companies/color/bewakoof.svg\"},{\"name\":\"Flipkart\",\"img_url\":\"uploads/images/top-companies/white/flipkart.svg\",\"img_color_url\":\"uploads/images/top-companies/color/flipkart.svg\"},{\"name\":\"Capgemini\",\"img_url\":\"uploads/images/top-companies/white/capgemini.svg\",\"img_color_url\"