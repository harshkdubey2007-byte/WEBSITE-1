{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services",
      "destination": "/digital-marketing-services",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/tools",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/tools/:path*",
      "permanent": true
    },
    {
      "source": "/alumini/blog/author/:path*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/alumini/blog/:path*/feed",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/alumini/blog.1",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/alumini/blog",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/alumini/blog/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/alumini",
      "destination": "/alumni",
      "permanent": true
    },
    {
      "source": "/alumini/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/upcoming-masterclasses",
      "permanent": true
    },
    {
      "source": "/upcoming-Masterclasses",
      "destination": "/upcoming-masterclasses",
      "permanent": true
    },
    {
      "source": "/digital-marketing-course",
      "destination": "/digital-marketing-course-in-bhopal",
      "permanent": true
    },
    {
      "source": "/seo-course",
      "destination": "/services/seo",
      "permanent": true
    },
    {
      "source": "/social-media-marketing-course",
      "destination": "/services/social-media-marketing",
      "permanent": true
    },
    {
      "source": "/performance-marketing-course",
      "destination": "/services/performance-marketing",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/online-digital-marketing-course/_next/static/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/HomePageAssets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/blog/wp-content/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "functions": {
    "api/check-links.js": {
      "maxDuration": 60
    },
    "api/site-info.js": {
      "maxDuration": 30
    }
  }
}
